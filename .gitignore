# Local dependency jars: a workspace workaround for having no network.
# Do not commit them long-term; see README section 4.
libs/*.jar

# Datagen scratch state. The generated models/lang ARE committed (they are
# shipped in the jar), but this cache is pure build state.
src/generated/resources/.cache/

# Local build tooling: convenience scripts, not part of the distributed mod.
# Leading slash anchors this to the repository root so a nested _tools/ inside
# src/ would still be tracked.
/_tools/

# Development log: kept locally, intentionally not published.
/CHANGELOG.dev.md

# OS
.DS_Store
Thumbs.db
